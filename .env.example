# .env
NEXT_PUBLIC_APP_URL=https://withmeridian.org
INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow
EMAIL=
LICENSE_KEY=

# Twitter monitor persistence. Leave unset to use the local .data JSON fallback.
DATABASE_URL=mysql://USERNAME:PASSWORD@aws.connect.psdb.cloud/DATABASE_NAME

# Optional guards for the cron collector and external metric ingestion.
CRON_SECRET=replace-with-a-random-secret
TWITTER_MONITOR_INGEST_SECRET=replace-with-a-random-secret
