# .env
NEXT_PUBLIC_APP_URL=https://withmeridian.org
INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow
EMAIL=
LICENSE_KEY=

# Twitter monitor persistence. Leave unset to use the local .data JSON fallback.
DATABASE_URL=mysql://USERNAME:PASSWORD@aws.connect.psdb.cloud/DATABASE_NAME

# Twitter API45 collection through RapidAPI and endpoint guards.
RAPIDAPI_KEY=replace-with-your-rapidapi-key
CRON_SECRET=replace-with-a-random-secret
TWITTER_MONITOR_INGEST_SECRET=replace-with-a-random-secret

# Required in production: mandatory access form and Notion lead storage.
TWITTER_MONITOR_ACCESS_SECRET=replace-with-at-least-32-random-characters
NOTION_API_TOKEN=secret_replace-with-your-notion-integration-token
NOTION_LEADS_PAGE_ID=3caabc2b-f905-803a-b161-cbd01eed1060

# Required to send monitoring reports through Cloudflare Email Sending.
CLOUDFLARE_ACCOUNT_ID=replace-with-your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=replace-with-an-email-sending-api-token
CLOUDFLARE_EMAIL_FROM=reports@your-verified-domain.com
CLOUDFLARE_EMAIL_FROM_NAME=Meridian
CLOUDFLARE_EMAIL_REPLY_TO=hello@your-verified-domain.com

# SEO course payments and signed access. Keep all private keys server-side.
SEO_COURSE_ACCESS_SECRET=replace-with-at-least-32-random-characters

# Stripe Checkout. Create a webhook endpoint for /api/seo-course/stripe-webhook.
STRIPE_SECRET_KEY=sk_test_replace-with-your-secret-key
STRIPE_WEBHOOK_SECRET=whsec_replace-with-your-webhook-signing-secret
STRIPE_PAYMENT_METHOD_CONFIGURATION=pmc_1StgF5L8wdcuLUq6sOmvV4hi
