{
  "name": "shadcn-nextjs-flow-landing-page",
  "version": "2.0.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "prestart": "pnpm build",
    "start": "next start",
    "test": "node --test src/lib/twitter-monitor/access.test.mjs src/lib/twitter-monitor/store.test.mjs src/lib/rate-limit.test.mjs",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm lint && pnpm typecheck && pnpm build",
    "indexnow:submit": "node scripts/submit-indexnow.mjs --sitemap",
    "indexnow:changed": "node scripts/submit-indexnow.mjs --changed",
    "indexnow:dry-run": "node scripts/submit-indexnow.mjs --changed --dry-run",
    "seo:lang:check": "node scripts/check-language-signals.mjs"
  },
  "dependencies": {
    "@datafast/ai-crawl": "^1.0.9",
    "@planetscale/database": "^1.20.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "gray-matter": "4.0.3",
    "lucide-react": "1.17.0",
    "motion": "12.40.0",
    "next": "16.2.6",
    "next-mdx-remote-client": "2.1.10",
    "next-themes": "0.4.6",
    "radix-ui": "1.4.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-use": "17.6.0",
    "recharts": "3.8.0",
    "remark-gfm": "^4.0.1",
    "stripe": "^22.6.1",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "25.9.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.6",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "0.8.0",
    "shadcn": "4.8.2",
    "tailwindcss": "4.3.0",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3"
  },
  "resolutions": {
    "framer-motion": "12.29.2"
  },
  "overrides": {
    "framer-motion": "12.29.2"
  }
}
